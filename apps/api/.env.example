APP_NAME="Research Agent Backend"
ENVIRONMENT=local
API_PREFIX=/v1
FRONTEND_ORIGIN=http://localhost:3000

# Clerk
# Example issuer: https://your-clerk-instance.clerk.accounts.dev
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
AUTH_REQUIRED=false

# Persistence
# Options: memory, postgres, mongodb
STORAGE_BACKEND=postgres
AUTO_CREATE_DATABASE_SCHEMA=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/research_agent
MIGRATIONS_DATABASE_URL=
MONGODB_URI=
MONGODB_DATABASE=research_agent
MONGODB_APP_NAME=ResearchAgent
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
OBJECT_STORAGE_BUCKET=
ARTIFACT_STORAGE_BACKEND=none
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=

# Queue
JOB_QUEUE_BACKEND=sync
RESEARCH_JOB_QUEUE_NAME=research:jobs
WORKER_POLL_SECONDS=2
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Security and payment policy
HMAC_SECRET=replace-with-strong-local-secret
SUPPORTED_PAYMENT_ASSETS=USDC
SUPPORTED_PAYMENT_NETWORKS=base-sepolia,base
MAX_PAYMENT_PIN_ATTEMPTS=5
PAYMENT_PIN_LOCK_SECONDS=900
X402_ENABLED=false
# Exact provider hostnames only, comma separated. Never add wildcards.
X402_PROVIDER_ALLOWLIST=
X402_TIMEOUT_SECONDS=20
X402_MAX_RESPONSE_BYTES=1000000
# Optional x402-enabled commerce service. Ordinary retailer URLs are never treated as payment endpoints.
X402_COMMERCE_ENDPOINT=
X402_COMMERCE_PROVIDER_ID=commerce

# Optional DeepSeek report enhancement and feedback revisions.
# The backend remains deterministic and testable when this is blank.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_RETRIES=2
BROWSER_HEADLESS=true
# Optional: use an installed Chrome/Edge executable and skip a Chromium download.
BROWSER_EXECUTABLE_PATH=
BROWSER_TIMEOUT_SECONDS=20
BROWSER_MAX_SOURCES=8
BROWSER_ARTIFACT_DIR=storage/browser
# Optional search APIs. When blank, Bing RSS and DuckDuckGo are used.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
WEB_RESEARCH_TIMEOUT_SECONDS=15
WEB_RESEARCH_MAX_RESPONSE_BYTES=2000000
LOG_LEVEL=INFO
