APP_NAME="Research Agent Backend"
ENVIRONMENT=local
API_PREFIX=/v1
FRONTEND_ORIGIN=http://localhost:3000

# Clerk
# Example issuer: https://your-clerk-instance.clerk.accounts.dev
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
AUTH_REQUIRED=false

# Database-ready placeholders. Current scaffold uses in-memory storage.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research_agent
OBJECT_STORAGE_BUCKET=

# Security and payment policy
HMAC_SECRET=replace-with-strong-local-secret
SUPPORTED_PAYMENT_ASSETS=USDC
SUPPORTED_PAYMENT_NETWORKS=base-sepolia,base
MAX_PAYMENT_PIN_ATTEMPTS=5
PAYMENT_PIN_LOCK_SECONDS=900

