APP_NAME="Research Agent Backend"
ENVIRONMENT=local
API_PREFIX=/v1
FRONTEND_ORIGIN=http://localhost:3000

# Clerk
# Example issuer: https://your-clerk-instance.clerk.accounts.dev
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
AUTH_REQUIRED=false

# Persistence
STORAGE_BACKEND=postgres
AUTO_CREATE_DATABASE_SCHEMA=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/research_agent
MIGRATIONS_DATABASE_URL=
OBJECT_STORAGE_BUCKET=

# Queue
JOB_QUEUE_BACKEND=sync
RESEARCH_JOB_QUEUE_NAME=research:jobs
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Security and payment policy
HMAC_SECRET=replace-with-strong-local-secret
SUPPORTED_PAYMENT_ASSETS=USDC
SUPPORTED_PAYMENT_NETWORKS=base-sepolia,base
MAX_PAYMENT_PIN_ATTEMPTS=5
PAYMENT_PIN_LOCK_SECONDS=900
